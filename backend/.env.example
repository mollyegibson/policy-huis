# Copy to .env in this directory (gitignored) and fill in. Never commit .env or paste its values anywhere.

# The app Neon project, as its owner role: the backend runs the app schema's migrations and writes traces.
APP_DATABASE_URL=postgresql://<owner>:<password>@<host>/<database>?sslmode=require

# The port this backend's question API listens on.
BACKEND_PORT=

# API key for each cloud model configuration in config/agent.yaml, named <CONFIGURATION>_API_KEY.
# Only the configuration being run needs its key; the local configuration needs none.
FRONTIER_API_KEY=
SAME_MODEL_CLOUD_API_KEY=
