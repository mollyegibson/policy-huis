# Copy to .env in this directory (gitignored) and fill in. Never commit .env or paste its values anywhere.

# sf-data Neon project: the owner role's connection string, used for migrations, loads and dbt.
SF_DATA_DATABASE_URL=postgresql://<owner>:<password>@<host>/<database>?sslmode=require

# Password for the read-only sf_data_reader role, which migration 0001 creates. Choose a new one.
SF_DATA_READER_PASSWORD=

# Neon object storage, where loaders archive every downloaded source file.
NEON_S3_ENDPOINT=
NEON_S3_REGION=
NEON_S3_BUCKET=
NEON_S3_ACCESS_KEY_ID=
NEON_S3_SECRET_ACCESS_KEY=
