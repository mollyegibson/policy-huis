# Copy to .env in this directory (gitignored) and fill in. Never commit .env or paste its values anywhere.

# The sf-docs database as its owner role: used for migrations, loads and passages. For a local dry run, a
# throwaway Postgres, such as a Docker container.
SF_DOCS_DATABASE_URL=postgresql://<owner>:<password>@<host>/<database>?sslmode=require

# Password for the read-only sf_docs_reader role, which migration 0001 creates. Choose a new one.
SF_DOCS_READER_PASSWORD=

# An OpenRouter API key, for embedding the search entries with the model and host in config/search.yaml.
OPENROUTER_API_KEY=

# Neon object storage, where loaders archive every downloaded document. Not needed with --archive-dir for a dry run.
NEON_S3_ENDPOINT=
NEON_S3_REGION=
NEON_S3_BUCKET=
NEON_S3_ACCESS_KEY_ID=
NEON_S3_SECRET_ACCESS_KEY=
