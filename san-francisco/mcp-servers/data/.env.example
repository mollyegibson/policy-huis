# Copy to .env in this directory (gitignored) and fill in. Never commit .env or paste its values anywhere.

# The sf-data Neon project, as the read-only sf_data_reader role created by san-francisco/ingest/data's migration.
SF_DATA_READER_DATABASE_URL=postgresql://sf_data_reader:<password>@<host>/<database>?sslmode=require

# The port this MCP server listens on.
SF_DATA_PORT=
