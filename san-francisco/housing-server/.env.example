# Copy to .env in this directory (gitignored) and fill in. Never commit .env or paste its values anywhere.

# The sf-housing Neon project, as the read-only sf_housing_reader role created by san-francisco/ingest's migration.
SF_HOUSING_READER_DATABASE_URL=postgresql://sf_housing_reader:<password>@<host>/<database>?sslmode=require

# The port this MCP server listens on.
SF_HOUSING_PORT=
