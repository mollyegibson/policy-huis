# Copy to .env in this directory (gitignored) and fill in. Never commit .env or paste its values anywhere.

# The sf-docs Neon project, as the read-only sf_docs_reader role created by san-francisco/ingest/documents'
# migration.
SF_DOCS_READER_DATABASE_URL=postgresql://sf_docs_reader:<password>@<host>/<database>?sslmode=require

# The port this MCP server listens on.
SF_DOCS_PORT=

# An OpenRouter API key, for embedding search queries with the model and host in config/search.yaml.
OPENROUTER_API_KEY=
