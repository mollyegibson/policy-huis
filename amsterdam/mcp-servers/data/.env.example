# Copy to .env in this directory (gitignored) and fill in. Never commit .env or paste its values anywhere.

# The ams-data Neon project, as the read-only ams_data_reader role created by amsterdam/ingest/data's migration.
AMS_DATA_READER_DATABASE_URL=postgresql://ams_data_reader:<password>@<host>/<database>?sslmode=require

# The port this MCP server listens on.
AMS_DATA_PORT=
