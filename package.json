{
  "name": "policyhuis",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "backend",
    "protocol",
    "shared/mcp-kit",
    "shared/node-config",
    "san-francisco/housing-server"
  ],
  "scripts": {
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "test": "yarn workspaces foreach -A run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "yarn workspaces foreach -A -p -i --include '@policyhuis/sf-housing-server' --include '@policyhuis/backend' run start"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.4"
  }
}
