# Copy to .env in this directory (gitignored) and fill in. Never commit .env or paste its values anywhere.

# The ams-docs Neon project, as the read-only ams_docs_reader role created by amsterdam/ingest/documents'
# migration.
AMS_DOCS_READER_DATABASE_URL=postgresql://ams_docs_reader:<password>@<host>/<database>?sslmode=require

# The port this MCP server listens on.
AMS_DOCS_PORT=

# An OpenRouter API key, for embedding search queries with the model and host in config/search.yaml.
OPENROUTER_API_KEY=
