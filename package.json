{
  "name": "policyhuis",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "backend",
    "browser-app",
    "protocol",
    "evaluation",
    "shared/node-config",
    "san-francisco/mcp-servers/data",
    "san-francisco/mcp-servers/documents",
    "scripts"
  ],
  "scripts": {
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "test": "yarn workspaces foreach -A run test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "node scripts/dev.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.4"
  }
}
