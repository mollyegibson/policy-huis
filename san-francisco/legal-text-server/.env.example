# Copy to .env in this directory (gitignored) and fill in. Never commit .env or paste its values anywhere.

# The sf-legal-text Neon project, as the read-only sf_legal_text_reader role created by san-francisco/legal-text's
# migration.
SF_LEGAL_TEXT_READER_DATABASE_URL=postgresql://sf_legal_text_reader:<password>@<host>/<database>?sslmode=require

# The port this MCP server listens on.
SF_LEGAL_TEXT_PORT=

# Ollama, which embeds search queries with the build in config/search.yaml. Optional; this is the default.
# OLLAMA_URL=http://localhost:11434
