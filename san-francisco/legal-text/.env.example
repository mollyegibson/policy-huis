# Copy to .env in this directory (gitignored) and fill in. Never commit .env or paste its values anywhere.

# The sf-legal-text database as its owner role: used for migrations, loads and passages. For a local dry run, a
# throwaway Postgres, such as a Docker container.
SF_LEGAL_TEXT_DATABASE_URL=postgresql://<owner>:<password>@<host>/<database>?sslmode=require

# Password for the read-only sf_legal_text_reader role, which migration 0001 creates. Choose a new one.
SF_LEGAL_TEXT_READER_PASSWORD=

# Ollama, which embeds the search entries (sf-legal-text passages). Optional; this is the default.
# OLLAMA_URL=http://localhost:11434

# Voyage AI API key, used only by the spike S4 harness for the cloud embedding baseline. Optional.
VOYAGE_API_KEY=

# Neon object storage, where loaders archive every downloaded document. Not needed with --archive-dir for a dry run.
NEON_S3_ENDPOINT=
NEON_S3_REGION=
NEON_S3_BUCKET=
NEON_S3_ACCESS_KEY_ID=
NEON_S3_SECRET_ACCESS_KEY=
