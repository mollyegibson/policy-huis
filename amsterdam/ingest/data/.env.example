# Copy to .env in this directory (gitignored) and fill in. Never commit .env or paste its values anywhere.

# ams-data Neon project: the owner role's connection string, used for migrations, loads and dbt.
AMS_DATA_DATABASE_URL=postgresql://<owner>:<password>@<host>/<database>?sslmode=require

# Password for the read-only ams_data_reader role, which migration 0001 creates. Choose a new one.
AMS_DATA_READER_PASSWORD=

# Neon object storage, where loaders archive every downloaded source file.
NEON_S3_ENDPOINT=
NEON_S3_REGION=
NEON_S3_BUCKET=
NEON_S3_ACCESS_KEY_ID=
NEON_S3_SECRET_ACCESS_KEY=

# RVO's EP-Online API key, requested once at https://epbdwebservices.rvo.nl/. Only needed to ingest the
# ep_online_energielabels source; the key expires after a year of disuse.
EP_ONLINE_API_KEY=
